# Python ingestion
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
OPENFOODFACTS_USER_AGENT="FitTrackFoodImporter/1.0 (Fitness Tracker data sync)"
OPENFOODFACTS_ENDPOINT=https://world.openfoodfacts.org/cgi/search.pl
MAX_FETCH_RETRIES=5
OPENFOODFACTS_MAX_BACKOFF_SECONDS=20

# Optional: registered OpenFoodFacts account for priority access during high load
OPENFOODFACTS_USER_ID=
OPENFOODFACTS_PASSWORD=
RUN_MODE=export
TARGET_COUNT=50
MAX_PER_TERM=50
EXPORT_JSON_PATH=db/foods_export.json
EXPORT_SQL_PATH=sql/foods_seed_from_openfoodfacts.sql
SUPABASE_DB_HOST=db.<project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<password>
SUPABASE_DB_SSLMODE=require

# PHP runtime (strictly pooler)
SUPABASE_PG_POOLER_DSN=pgsql:host=aws-1-eu-west-2.pooler.supabase.com;port=6543;dbname=postgres;sslmode=require
SUPABASE_PG_POOLER_USER=postgres.<project-ref>
SUPABASE_PG_POOLER_PASSWORD=<password>

# Plan B image mirroring (Supabase Storage)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=food-images
IMAGE_MODE=direct
