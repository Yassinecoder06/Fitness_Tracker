# Local Supabase (Docker via Supabase CLI)
# Copy this file to .env when running the project against localhost.

# Local database connection
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
SUPABASE_DB_HOST=127.0.0.1
SUPABASE_DB_PORT=54322
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=postgres
SUPABASE_DB_SSLMODE=disable

# PHP runtime (project expects these three vars)
SUPABASE_PG_POOLER_DSN=pgsql:host=127.0.0.1;port=54322;dbname=postgres;sslmode=disable
SUPABASE_PG_POOLER_USER=postgres
SUPABASE_PG_POOLER_PASSWORD=postgres

# Local Supabase API
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
