# Python ingestion
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# PHP runtime
SUPABASE_PG_DSN=pgsql:host=db.<project-ref>.supabase.co;port=5432;dbname=postgres;sslmode=require
SUPABASE_PG_USER=postgres
SUPABASE_PG_PASSWORD=<password>

# Plan B image mirroring (Supabase Storage)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_STORAGE_BUCKET=food-images
IMAGE_MODE=mirror
